    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ghost/security": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
