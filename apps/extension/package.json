{
  "name": "@ghost/extension",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npx esbuild src/background.ts --bundle --outfile=dist/background.js && npx esbuild src/content.ts --bundle --outfile=dist/content.js",
