{
  "manifest_version": 3,
  "name": "Ghost Retail Worker Recorder",
  "version": "0.1.0",
  "description": "Records semantic browser task evidence for Ghost Retail Worker.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
