# ─────────────────────────────────────────────────────────────────────────────
# Autoworker / Ghost Retail Worker — Environment Configuration Template
#
# Instructions:
# 1. Copy this file to `.env` in the project root:
#      cp .env.example .env
# 2. Fill in the values marked [REQUIRED] for your deployment scenario.
# 3. Default values are safe for local development with seeded mocks.
# 4. NEVER commit your actual `.env` file containing secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API & Server Configuration ───────────────────────────────────────────────
# Node environment mode: 'development', 'production', or 'test'
NODE_ENV=development
# Port on which the Express API server listens
PORT=4000
# URL of the web dashboard (frontend)
APP_URL=http://localhost:5173
# Base URL for the backend API
API_URL=http://localhost:4000
# Logging verbosity: 'fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent'
LOG_LEVEL=info

# ── Database & Persistence (Supabase PostgreSQL) ─────────────────────────────
# Storage backend: 'supabase' (persistent database), 'memory' (in-memory mock), or 'auto'
# [REQUIRED for persistent multi-tenant workflows]
STORAGE_PROVIDER=supabase

# Supabase Project URL (e.g. https://your-project.supabase.co or http://127.0.0.1:54321 for local emulator)
SUPABASE_URL=replace-with-your-supabase-url
# Supabase Anon Public Key (used for client-side API requests)
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# Supabase Service Role Secret (used exclusively by backend API/Worker with full privileges)
# CAUTION: Never expose this key in client-side bundles or public endpoints.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
# Direct PostgreSQL connection string for database migrations and connection pooler
DATABASE_URL=postgresql://postgres:replace-with-your-db-password@db.your-project.supabase.co:5432/postgres

# Frontend Vite Supabase client parameters (read at build/run time by apps/web)
VITE_SUPABASE_URL=replace-with-your-supabase-url
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Memory storage fallback toggle: Set to 'true' only for quick stateless local testing without Supabase
ALLOW_MEMORY_STORAGE=false

# ── Primary Multimodal LLM: OpenRouter (Video & Intent Extraction) ────────────
# [REQUIRED for Video Demonstration Extraction & BPI reasoning]
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Primary text model for workflow planning and task synthesis
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Vision-capable model for video keyframe understanding and element grounding
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b:free
# Reasoning model for adversarial critics and semantic validation
OPENROUTER_REASONING_MODEL=qwen/qwen3.8-27b:free
# OpenRouter API base endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Site metadata sent in HTTP-Referer / X-Title headers for OpenRouter rankings
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Ghost Autonomous Worker

# Budget and Cost Guard Controls
# When false, only free-tier models (e.g. :free tag) are permitted
ALLOW_PAID_MODELS=false
# Maximum parallel requests to LLM provider
OPENROUTER_MAX_CONCURRENT_REQUESTS=1
# Request retry limit on rate-limiting (429) or transient provider errors
OPENROUTER_MAX_RETRIES=1

# ── Fallback LLM Providers (Optional Resiliency Cascade) ──────────────────────
# Fallback Provider 1: Google Gemini API
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Fallback Provider 2: Groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback Provider 3: Custom OpenAI-compatible endpoint
FALLBACK_LLM_API_KEY=replace-with-your-custom-llm-api-key
FALLBACK_LLM_MODEL=replace-with-your-custom-model-id
FALLBACK_LLM_BASE_URL=https://your-custom-llm-endpoint/v1

# ── Video & Desktop Evidence Sampling Constraints ───────────────────────────
# Maximum frames included in a single LLM request
MAX_LLM_IMAGES_PER_REQUEST=6
# Absolute ceiling on keyframes extracted across an entire video job
MAX_LLM_IMAGES_TOTAL=30
# Frame extraction rate from video evidence (frames per second)
VIDEO_SAMPLE_FPS=1
# Maximum frames captured per interaction segment
MAX_FRAMES_PER_SEGMENT=4
# Maximum segments allowed per demonstration video
MAX_SEGMENTS_PER_VIDEO=20
# Enable independent critic evaluation pass on compiled workflows
ENABLE_WORKFLOW_CRITIC=false
# Pipeline analysis depth: 'FAST' (optimized latency), 'BALANCED', or 'DEEP'
ANALYSIS_MODE=FAST
# Toggle multimodal vision OCR enrichment for dense UI text
ENABLE_VISION_LLM_OCR=false

# ── Browser Execution Engine (Playwright / Chromium / Browserbase) ───────────
# Cloud browser automation credentials (optional). Leave blank to use local Chromium.
BROWSERBASE_API_KEY=replace-with-your-browserbase-api-key
BROWSERBASE_PROJECT_ID=replace-with-your-browserbase-project-id

# Local browser settings:
# When true, browser runs in the background without UI. Set false for visual debugging.
WORKER_HEADLESS=false
# Delay in milliseconds between simulated user actions
WORKER_SLOW_MO=0
# Prevent browser close on run completion for visual inspection
KEEP_BROWSER_OPEN=false

# ── Desktop Agent & Native Evidence Engine (FastMCP Python) ──────────────────
# Python executable path for invoking the Desktop Evidence Engine FastMCP bridge
# Leave blank to detect python/python3 from system PATH
PYTHON_PATH=
# Stagehand vision model override for desktop DOM operations
STAGEHAND_MODEL=

# ── Security & Cryptographic Controls ─────────────────────────────────────────
# Secret used to HMAC-sign and verify outbound webhook event payloads
WEBHOOK_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
# Symmetric encryption key for securing stored third-party credentials (AES-256)
ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key
# Human-in-the-Loop (HITL) pause session timeout in seconds before auto-expiring
HITL_SESSION_TIMEOUT_SECONDS=300

# ── Optional Infrastructure ──────────────────────────────────────────────────
# Redis connection URL (used for distributed task queue and worker coordination)
REDIS_URL=
# Sentry DSN for production application monitoring and error reporting
SENTRY_DSN=

# ── Local Development Authentication Seeder ─────────────────────────────────
# Security notice: These dev authentication settings are strictly locked to non-production
# environments (NODE_ENV !== 'production'). They have no effect in production.
ALLOW_DEV_AUTH=true
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=admin@ghost.local
DEV_AUTH_PASSWORD=Ghost@123456
DEV_AUTH_USER_ID=00000000-0000-0000-0000-000000000002
# Admin credentials used by `scripts/seed-dev-user.ts`
DEV_ADMIN_EMAIL=admin@ghost.local
DEV_ADMIN_PASSWORD=Ghost@123456
